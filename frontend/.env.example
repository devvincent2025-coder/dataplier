# Public site origin for canonical URLs, Open Graph, and JSON-LD (no trailing slash).
# Copy to `.env` or `.env.local` for local/preview builds if your public URL differs.
# VITE_SITE_URL=https://dataplier.com

# End-to-end UI walkthrough without the API gateway: in-memory connections, datasets,
# pipelines, jobs, routing, and governance fixtures. See `src/config/demoMode.ts`.
# VITE_USE_DEMO_DATA=true
# Sign in with demo@dataplier.com / demo1234 (see demoMode.ts for constants).
