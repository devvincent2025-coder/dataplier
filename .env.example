POSTGRES_DSN=postgres://dataplier:dataplier@postgres:5432/dataplier?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
JWT_SECRET=change-me
KAFKA_BROKERS=kafka:9092
TEMPORAL_ADDRESS=temporal:7233
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dataplier
AES_SECRET_KEY=replace-with-32-byte-key
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CONNECTION_SERVICE_PORT=8082
DATASET_SERVICE_PORT=8083
PIPELINE_SERVICE_PORT=8084
JOB_SERVICE_PORT=8085
METADATA_SERVICE_PORT=8086
OBSERVABILITY_SERVICE_PORT=8087
LINEAGE_SERVICE_PORT=8088
CHUNK_ENGINE_PORT=8090
TRANSFORMATION_ENGINE_PORT=8091
ROUTING_ENGINE_PORT=8092
SCHEMA_TRANSLATOR_PORT=8093
TIME_MACHINE_PORT=8094
AI_CONTROLLER_PORT=8095
AUTH_SERVICE_URL=http://auth-service:8081
CONNECTION_SERVICE_URL=http://connection-service:8082
DATASET_SERVICE_URL=http://dataset-service:8083
PIPELINE_SERVICE_URL=http://pipeline-service:8084
JOB_SERVICE_URL=http://job-service:8085
METADATA_SERVICE_URL=http://metadata-service:8086
OBSERVABILITY_SERVICE_URL=http://observability-service:8087
LINEAGE_SERVICE_URL=http://lineage-service:8088
ROUTING_ENGINE_URL=http://routing-engine:8092

# Shared secret for POST /metrics/ingest/spans (api-gateway, job-service → observability). Required for automatic trace ingest.
OBS_INGEST_SECRET=local-dev-ingest-key-change-me
# Default HMAC key for webhook signing when a channel has no signing_secret (optional).
OBS_WEBHOOK_DEFAULT_SECRET=local-webhook-hmac-change-me
# Set to 0 to disable the outbound delivery worker in observability-service.
OBS_DELIVERY_WORKER=1

# Stripe billing (metadata-service). Point Stripe webhooks to POST https://<your-api-gateway>/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
